# Normalise line endings so a diff never turns into a whole-file rewrite.
* text=auto eol=lf

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.webmanifest text eol=lf

# Binary — never diffed, never line-ending-converted.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.ico    binary
*.woff   binary
*.woff2  binary
