# Copy to .env on the droplet. NEVER commit the filled-in copy — this repo is
# public, and everything in it is published.

POSTGRES_PASSWORD=change-me-long-random
MIZAN_APP_PASSWORD=change-me-long-random

# where the API is reachable from the internet, used to build /j/ links
PUBLIC_URL=https://mizan.example.com
# where a coach lands after their link sets the cookie
APP_URL=https://malikai-786.github.io/mizan/coach/

# Managed Postgres instead of the compose db? Point DATABASE_URL at it and
# leave PGSSL unset — DigitalOcean managed databases require TLS.
# DATABASE_URL=postgresql://mizan_app:...@db-postgresql-nyc3-xxxxx.b.db.ondigitalocean.com:25060/mizan?sslmode=require
